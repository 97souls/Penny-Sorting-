import java.util.Arrays;
import java.util.Random;
import java.util.Scanner; // importing the necessary utility to create an array
 
public class RandomPennyYearsGenerator {
    public static void main(String[] args) {
        final int ARRAY_SIZE = 50;
        final int START_YEAR = 1909;
        final int END_YEAR = 2025;
 
        int[] pennyYears = new int[ARRAY_SIZE];
        Random rand = new Random();
 
        for (int i = 0; i < ARRAY_SIZE; i++) {
            pennyYears[i] = rand.nextInt(END_YEAR - START_YEAR + 1) + START_YEAR;
        }
 
        System.out.println("Array of " + ARRAY_SIZE + " Penny Years (Range: " + START_YEAR + " - " + END_YEAR + "):");
        for (int i = 0; i < ARRAY_SIZE; i++) {
            System.out.println(pennyYears[i]);
 
        }
        SortThePennies(pennyYears);
 
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter the penny year to search for: ");
        int year = scanner.nextInt();
 
        // Performs binary search
        if (binarySearch(pennyYears, year)) {
            System.out.println("Yes, a penny from " + year + " exists in the collection.");
        } else {
            System.out.println("No, a penny from " + year + " does not exist in the collection.");
        }
 
        scanner.close();
    }
 
 
public static void SortThePennies(int[] pennies)//FIRST SORT TIME IS WAYY HIGHER THAN NEXT ONES AND PARALLEL SORT BECOMES SLOWER THAN NORMAL SORT
{
 
    for(int i = 0; i < 2; i++){
      long t0 = System.nanoTime();
    Arrays.sort(pennies); // Sorting the initialized array from the line of code above. This is the sequential sorting of the "pennies" array.
    //System.out.println("Here are the pennies sorted from oldest to newest (Normal sort): " + Arrays.toString(pennies)); // Displaying the pennies from the array after they have been sequentially sorted in order from oldest to newest
    long t1 = System.nanoTime();
  System.out.println("Time taken for normal sort: " + (t1 - t0) + " milliseconds");
 
      long t2 = System.nanoTime();
    Arrays.parallelSort(pennies); // Sorting the "pennies" array parallelly. This is the parallel sorting of the "pennies" array.
   // System.out.println("Here are the pennies sorted from oldest to newest (Parallel Sort): " + Arrays.toString(pennies)); // Displaying the pennies from the array after they have been parallelly sorted in order from oldest to
      long t3 = System.nanoTime();
  System.out.println("Time taken for parallel sort: " + (t3-t2) + " milliseconds");
    System.out.println("Speedup: " + ((t1 - t0) / (t3 - t2)));
}
}
 
 
    public static boolean binarySearch(int[] arr, int target)
    {
        // int low = 0 sets starting point of array at 0 and sets ending point
        // high = arr.length - 1 sets ending point of array
        // arr.length is total number of items in array
        int low = 0, high = arr.length - 1;
 
        // use while loop because we do not know how many steps to find the penny year
        // while loop repeats as long as there is still years to check
        while (low <= high) // Still searches as long as sections of lists(year list) are present to check
        {
            int mid = (low + high) / 2;
            //Find middle b/w start(low) and end(high)
            //Checks if year is one that is being looked for, if so returns true
            if (arr[mid] == target)
            {
                return true; // Found, so true
            }
            else if (arr[mid] < target)
            {
                low = mid + 1; // Searches right half
            }
            else
            {
                high = mid - 1; // Searches left half
            }
        }
        return false; // Not found
    }
 
 
}
